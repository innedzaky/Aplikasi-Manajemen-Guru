# =========================================================================
# SISTEM MANAJEMEN GURU - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =========================================================================
# CATATAN KEAMANAN:
# - File ini hanya merupakan template konfigurasi publik.
# - JANGAN PERNAH menyimpan kredensial atau password rahasia di dalam file ini.
# =========================================================================

# URL Web App Google Apps Script backend (Format: https://script.google.com/macros/s/.../exec)
VITE_GAS_URL=""

# Mode Aplikasi Default ('demo' untuk pengujian offline, 'live' untuk koneksi Google Sheets)
VITE_APP_MODE="demo"

# Judul Aplikasi
VITE_APP_TITLE="Sistem Manajemen Guru"

# Nama Sekolah untuk Header Laporan & Dokumen PDF / Excel
VITE_SCHOOL_NAME="SMA NEGERI CONTOH"

# API Key Gemini (Server-Side Only - diinjeksi oleh platform bila diperlukan)
GEMINI_API_KEY=""

# Base URL Aplikasi (Otomatis diinjeksi oleh hosting/platform)
APP_URL=""
